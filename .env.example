# GoalStats frontend: native configuration. Existing .env.local is never overwritten.
# Default port; use 3001 locally when another application owns 3000.
APP_PORT=3000

# Native Next.js reaches the host-published Flask port, not container port 8000.
# Server-only origin; do not append /api/v1.
FOOTBALL_API_BASE_URL=http://127.0.0.1:5100
# Local Docker Compose always selects http://host.docker.internal:5100 instead.
# Never use container port 8000 for the native host-facing backend.

# Only explicit remote HTTPS backends require a service token for protected requests.
# Keep credentials private; never use NEXT_PUBLIC_ or commit a real token.
SERVICE_API_TOKEN=
