# GoalStats frontend local development.
APP_PORT=3000

# Server-only backend origins. Do not add /api/v1.
FOOTBALL_API_BASE_URL=https://goal-stats-service.onrender.com

# Server-only: required for protected requests to Render, even from local Next.js.
# Set privately to the matching backend token (>=32 printable ASCII, no whitespace).
# Never use NEXT_PUBLIC_ or commit a real credential. Public GETs need no token.
SERVICE_API_TOKEN=

# For unauthenticated local Flask development outside NODE_ENV=production / Vercel:
# FOOTBALL_API_BASE_URL=http://127.0.0.1:5100
# Remote backends require HTTPS with a public hostname; do not append /api/v1.
# Configure Preview and Production scopes explicitly in Vercel. Environment changes
# require a new deployment. Do not expose production credentials to untrusted previews.
